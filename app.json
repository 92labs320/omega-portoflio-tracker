{
  "expo": {
    "name": "Omega Portfolio Tracker",
    "slug": "omega-portfolio-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "omegaportfoliotracker",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.92labs.omegaportfolio",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "en",
        "NSFaceIDUsageDescription": "Omega uses Face ID to unlock your portfolio."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.labs92.omegaportfolio"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Omega uses Face ID to unlock your portfolio."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "platforms": [
      "ios",
      "android"
    ],
    "description": "Track your crypto and stock portfolio. Live prices, manual transactions, real profit and loss. No account required.",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f035d4b6-e0c2-467f-9989-81b67ac49fa7"
      }
    },
    "owner": "92labs320",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f035d4b6-e0c2-467f-9989-81b67ac49fa7",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
